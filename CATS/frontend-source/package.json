{
  "name": "cats-course-workspace-components",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run build:course && npm run build:calendar && npm run build:agent",
    "build:course": "vite build",
    "build:calendar": "vite build --config vite.calendar.config.ts",
    "build:agent": "vite build --config vite.agent.config.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-use-measure": "2.1.7",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "postcss": "8.5.29",
    "postcss-selector-parser": "7.1.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
